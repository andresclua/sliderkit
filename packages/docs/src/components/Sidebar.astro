---
import type { NavGroup } from '../nav'
import DemoSearch from './DemoSearch.astro'

interface Props {
  nav: NavGroup[]
  currentPath: string
  showSearch?: boolean
  collapsible?: boolean   // groups become <details>: the one holding the current page is open, the rest folded
}
const { nav, currentPath, showSearch = false, collapsible = false } = Astro.props

const norm = (p: string) => p.replace(/\/$/, '')
const here = norm(currentPath)
const isActive = (href: string) => norm(href) === here
const hasActive = nav.some(g => g.items.some(i => isActive(i.href)))
---
<aside class="sidebar">
  {showSearch && <DemoSearch />}
  {showSearch && (
    <a href="/demos" class={`all-demos-link${currentPath === '/demos/' || currentPath === '/demos' ? ' is-active' : ''}`}>
      ← All demos
    </a>
  )}
  <nav class="sidebar-nav">
    {nav.map(group => collapsible ? (
      // no page selected (the demos index): everything open. Otherwise only the current group.
      <details class="nav-group nav-group--fold" open={!hasActive || group.items.some(i => isActive(i.href))}>
        <summary class="nav-group-title">
          <span>{group.title}</span>
          <span class="nav-count">{group.items.length}</span>
        </summary>
        <ul>
          {group.items.map(item => (
            <li>
              <a href={item.href} class:list={['nav-item', isActive(item.href) && 'nav-item--active']}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </details>
    ) : (
      <div class="nav-group">
        <p class="nav-group-title">{group.title}</p>
        <ul>
          {group.items.map(item => (
            <li>
              <a href={item.href} class:list={['nav-item', isActive(item.href) && 'nav-item--active']}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </nav>
</aside>

<style>
.sidebar {
  width: var(--sidebar-w);
  flex-shrink: 0;
  border-right: 1px solid var(--border);
  background: var(--surface);
  overflow-y: auto;
  position: sticky;
  top: var(--header-h);
  height: calc(100vh - var(--header-h));
}
.sidebar-nav { padding: 1.25rem 0.75rem; }

.nav-group { margin-bottom: 1.5rem; }
.nav-group-title {
  font-size: 0.7rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--text-muted);
  padding: 0 0.6rem;
  margin-bottom: 0.35rem;
}
ul { list-style: none; }

/* collapsible groups (demos): a heading you can fold, with its items indented under a guide line */
.nav-group--fold { margin-bottom: 0.35rem; }
.nav-group--fold > summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  margin: 0;
  padding: 0.45rem 0.6rem;
  border-radius: 6px;
  cursor: pointer;
  list-style: none;
  user-select: none;
  transition: background 0.12s, color 0.12s;
}
.nav-group--fold > summary::-webkit-details-marker { display: none; }
.nav-group--fold > summary:hover { background: var(--hover); color: var(--text); }
.nav-group--fold > summary > span:first-child { display: inline-flex; align-items: center; gap: 0.45rem; }
.nav-group--fold > summary > span:first-child::before {
  content: '';
  width: 0.4rem; height: 0.4rem;
  border-right: 2px solid currentColor;
  border-bottom: 2px solid currentColor;
  transform: rotate(-45deg);
  transition: transform 0.15s;
}
.nav-group--fold[open] > summary > span:first-child::before { transform: rotate(45deg); }
.nav-count {
  font-size: 0.68rem;
  font-weight: 600;
  letter-spacing: 0;
  color: var(--text-muted);
  background: var(--hover);
  border-radius: 999px;
  padding: 1px 7px;
}
.nav-group--fold > ul {
  margin: 0.15rem 0 0.35rem 0.95rem;
  padding-left: 0.4rem;
  border-left: 1px solid var(--border);
}
.nav-item {
  display: block;
  padding: 5px 10px;
  border-radius: 6px;
  font-size: 0.875rem;
  color: var(--text);
  text-decoration: none;
  transition: background 0.12s, color 0.12s;
}
.nav-item:hover { background: var(--hover); color: var(--text); text-decoration: none; }
.nav-item--active {
  background: var(--tint);
  color: var(--brand);
  font-weight: 600;
}

.all-demos-link {
  display: block;
  margin: 0 0.75rem 0.5rem;
  padding: 5px 10px;
  font-size: 0.8rem;
  font-weight: 500;
  color: var(--text-muted);
  border-radius: 6px;
  text-decoration: none;
  transition: background 0.12s, color 0.12s;
}
.all-demos-link:hover { background: var(--hover); color: var(--text); text-decoration: none; }
.all-demos-link.is-active { color: var(--brand); font-weight: 600; }

@media (max-width: 768px) {
  .sidebar { display: none; }
}
</style>
