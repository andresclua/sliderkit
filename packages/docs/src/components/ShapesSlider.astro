---
// Draggable slider with a 3D character per feature, drawn in a single WebGL canvas, layered like:
//   back  → slider cards (DOM, receive the drag)
//   mid   → <canvas> with the characters, positioned from each card's rect every frame
//   front → title row (DOM), positioned from each slide's rect every frame
const MODELS = '/models/'
// Card backgrounds and the characters' body colours (see COLORS in lib/toys.ts) both come from the
// site palette. Each pair is chosen so the character stands out. `ink` is the big number's colour.
const DARK = '#00221A', LIGHT = '#ffffff'
const ITEMS = [
  { file: '01-lightweight-core',  name: 'Lightweight core',    bg: '#0F766E', ink: LIGHT },
  { file: '02-fully-accessible',  name: 'Fully accessible',    bg: '#CCFBF1', ink: DARK  },
  { file: '03-3-css-effects',     name: '3 CSS effects',       bg: '#00221A', ink: LIGHT },
  { file: '04-webgl-renderer',    name: 'WebGL renderer',      bg: '#005345', ink: LIGHT },
  { file: '05-10-plugins',        name: '10 plugins',          bg: '#99F6E4', ink: DARK  },
  { file: '06-touch-smooth-drag', name: 'Touch & smooth drag', bg: '#134E4A', ink: LIGHT },
  { file: '07-responsive',        name: 'Responsive',          bg: '#E2E8F0', ink: DARK  },
  { file: '08-typescript-strict', name: 'TypeScript strict',   bg: '#14B8A6', ink: DARK  },
]
---
<section class="shapes">
  <div class="shapes-stage" id="shapes-stage" data-models={MODELS}>
    <div id="shapes-slider">
      {ITEMS.map((it, i) => (
        <div class="shapes-slide" data-i={i} data-file={it.file} data-name={it.name}>
          <div class="shapes-card" style={`background:${it.bg}; --num:${it.ink}`}>
            <span class="shapes-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          </div>
        </div>
      ))}
    </div>
    <canvas class="shapes-canvas" aria-hidden="true"></canvas>
    <div class="shapes-fg"></div>
  </div>
</section>

<style is:global>
.shapes { background: transparent; color: var(--text); --info-h: 84px; padding: 48px 0 24px; }
.shapes-stage .sliderkit__outer { background: none; border-radius: 0; }
.shapes-stage { position: relative; isolation: isolate; overflow: hidden; cursor: grab; }
.shapes-stage:active { cursor: grabbing; }

/* the slide reserves the space; the front layer (same geometry) fills it with text */
.shapes-slide { padding: 24px 0 var(--info-h); }
.shapes-card  { aspect-ratio: 1; margin: 0 4%; }

.shapes-canvas { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 1; pointer-events: none; }
.shapes-fg     { position: absolute; inset: 0; z-index: 2; pointer-events: none; }
.shapes-fg-item {
  position: absolute; top: 0; left: 0; box-sizing: border-box; padding-top: 24px;
  display: flex; flex-direction: column;
  font: 500 0.72rem/1 ui-monospace, monospace;
  letter-spacing: 0.04em; text-transform: uppercase;
}
.fg-space { aspect-ratio: 1; margin: 0 4%; flex-shrink: 0; }
.fg-info  { padding: 22px 7.5% 0; }
.fg-row   { display: flex; justify-content: space-between; gap: 1rem; }

/* big index number in the card, behind the character */
.shapes-card { position: relative; container-type: inline-size; }
.shapes-num {
  position: absolute; top: 4cqw; right: 5cqw;
  font-family: var(--font-head); font-weight: 700; font-size: 16cqw; line-height: 0.8; letter-spacing: -0.05em;
  color: var(--num, #fff); pointer-events: none; user-select: none;
}

.shapes-stage .sliderkit__outer { padding-bottom: 56px; }
.shapes-stage .sliderkit__arrows { position: absolute; right: 24px; bottom: 10px; display: flex; gap: 10px; z-index: 10; }
.shapes-stage .sliderkit__arrow { position: static; transform: none; background: transparent; box-shadow: none; }
.shapes-stage .sliderkit__arrow svg { color: var(--text); }

</style>

<script>
import { Slider } from '@andresclua/sliderkit'
import { arrows, smooth } from '@andresclua/sliderkit-plugins'
import { createToys, newToyState, type ToyState } from '../lib/toys'

const stage  = document.getElementById('shapes-stage')!
const canvas = stage.querySelector<HTMLCanvasElement>('.shapes-canvas')!
const fgRoot = stage.querySelector<HTMLElement>('.shapes-fg')!
const base   = stage.dataset.models!

// smooth() replaces the core's drag (touch / mouseDrag off) and is ticked from the same
// rAF as the canvas, so cards and characters always move in the same frame.
const sm = smooth({ raf: false, skew: { target: '.shapes-card' } })
const slider = new Slider('#shapes-slider', {
  items: 1, loop: true, touch: false, mouseDrag: false,
  responsive: { 700: { items: 2 }, 1100: { items: 3 } },
  plugins: [sm, arrows()],
})

const files = [...new Set(slider.slides.map(s => s.dataset.file!))].sort()
const states: ToyState[] = files.map(() => newToyState())
const now = () => performance.now() / 1000

// ── Front layer: one block per slide (clones included, but inert) ───────────
const items = slider.slides.map(slide => {
  const d = slide.dataset
  const i = Number(d.i), clone = slide.classList.contains('sliderkit__item--clone')
  const fg = document.createElement('div')
  fg.className = 'shapes-fg-item'
  fg.dataset.i = String(i)
  fg.innerHTML =
    `<div class="fg-space"></div>` +
    `<div class="fg-info"><div class="fg-row"><span>${d.name}</span><span>SK / ${i + 1}</span></div></div>`
  if (clone) { fg.setAttribute('aria-hidden', 'true'); fg.setAttribute('inert', '') }
  fgRoot.appendChild(fg)
  return { slide, card: slide.querySelector<HTMLElement>('.shapes-card')!, fg, i, w: 0, h: 0 }
})

// ── Interaction: hovering a card wakes its character (active), clicking it makes it pop ──
const itemAt = (x: number, y: number) => items.find(it => {
  const r = it.card.getBoundingClientRect()
  return x >= r.left && x <= r.right && y >= r.top && y <= r.bottom
})

stage.addEventListener('pointermove', e => {
  if (e.pointerType === 'touch') return
  const hit = itemAt(e.clientX, e.clientY)
  states.forEach((s, i) => { if (!hit || hit.i !== i) { s.hover = false; s.px = 0; s.py = 0 } })
  if (hit) {
    const r = hit.card.getBoundingClientRect(), s = states[hit.i]!
    s.hover = true
    s.px = ((e.clientX - r.left) / r.width) * 2 - 1
    s.py = ((e.clientY - r.top) / r.height) * 2 - 1
  }
})
stage.addEventListener('pointerleave', () => states.forEach(s => { s.hover = false; s.px = 0; s.py = 0 }))
// a drag never reaches this (the plugin swallows its click); a plain click on a card pops the character
stage.addEventListener('click', e => {
  const hit = itemAt(e.clientX, e.clientY)
  if (hit) states[hit.i]!.popAt = now()
})

// ── Mid layer: one canvas, one character per card ───────────────────────────
const gl = canvas.getContext('webgl', { alpha: true, premultipliedAlpha: true, antialias: true, depth: true })
const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches
const toys = gl ? createToys(gl, files, base) : null
let loading = false
const loadToys = () => {
  if (!toys || loading) return
  loading = true
  files.forEach((_, i) => toys.load(i).catch(err => console.warn('toy failed to load', files[i], err)))
}

function frame(t: number) {
  sm.tick(t)
  const dpr = Math.min(devicePixelRatio || 1, 2)
  const s = stage.getBoundingClientRect()
  const cw = Math.round(s.width * dpr), ch = Math.round(s.height * dpr)
  if (canvas.width !== cw || canvas.height !== ch) { canvas.width = cw; canvas.height = ch }
  toys?.begin(cw, ch)

  for (const it of items) {
    const r = it.slide.getBoundingClientRect()
    const off = r.right < s.left - 80 || r.left > s.right + 80
    it.fg.style.visibility = off ? 'hidden' : 'visible'
    if (off) continue
    if (it.w !== r.width || it.h !== r.height) {
      it.w = r.width; it.h = r.height
      it.fg.style.width = r.width + 'px'; it.fg.style.height = r.height + 'px'
    }
    it.fg.style.transform = `translate3d(${r.left - s.left}px, ${r.top - s.top}px, 0)`

    if (!toys) continue
    const c = it.card.getBoundingClientRect()
    toys.draw(it.i, {
      cx: (c.left + c.width / 2 - s.left) * dpr, cy: (c.top + c.height / 2 - s.top) * dpr,
      side: it.card.offsetWidth * toys.K * dpr, dpr, canvasH: ch,
    }, states[it.i]!, t / 1000, reduced)
  }
}

// Only run while the stage is on screen; start fetching the models the first time it is.
let raf = 0
const loop = (t: number) => { frame(t); raf = requestAnimationFrame(loop) }
new IntersectionObserver(([e]) => {
  cancelAnimationFrame(raf)
  if (e!.isIntersecting) { loadToys(); raf = requestAnimationFrame(loop) }
}, { rootMargin: '200px' }).observe(stage)
</script>
